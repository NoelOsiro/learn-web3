{
  "name": "@cashflow/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsc --watch",
    "clean": "rm -rf dist node_modules",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "build": "npm run db:generate && tsc",
    "db:push": "dotenv -e ../../.env -- prisma db push --schema=./prisma/schema.prisma",
    "db:pull": "dotenv -e ../../.env -- prisma db pull --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "typescript": "^5.7.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}

